{
  "compilerOptions": {
    "allowJs": true,
    "target": "es2022",
    "module": "es2022",
    "lib": ["esnext", "DOM", "WebWorker", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "@builder.io/qwik",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "incremental": true,
    "isolatedModules": true,
    "outDir": "tmp",
    "noEmit": true,
    /* if you do not use CSS modules, remove this line and delete the typescript-plugin-css-modules module from package.json */
    "plugins": [{ "name": "typescript-plugin-css-modules" }]
  },
  "include": ["web-src", "./*.d.ts", "./*.config.ts"],
  "exclude": ["assets", "browser_wasi_shim", "node_modules", "tmp"]
}
